# Grocy MCP Server — environment variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Required: URL of your Grocy instance (no trailing slash)
GROCY_URL=https://grocy.example.com

# Required: API key from Grocy → Settings → Manage API keys
GROCY_API_TOKEN=your-grocy-api-key-here

# Optional: log level (debug | info | warning | error)
LOG_LEVEL=info

# Optional: port the MCP server listens on
MCP_PORT=8000

# Standalone Docker setup (docker-compose.grocy-mcp-standalone.yml) only:
# Required: token MCP clients send as "Authorization: Bearer <token>".
# Generate one with: openssl rand -hex 32
MCP_BEARER_TOKEN=

# Optional: host name clients use; Caddy's certificate is issued for it
# MCP_SITE_ADDRESS=localhost
# Optional: "internal" (Caddy's own CA) or an email address for a public ACME certificate
# MCP_TLS=internal
# Optional: host port for HTTPS
# MCP_HTTPS_PORT=8443
# Optional: client IP ranges allowed to connect (Caddy remote_ip syntax)
# MCP_ALLOWED_IPS=private_ranges
